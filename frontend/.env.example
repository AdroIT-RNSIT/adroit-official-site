VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never prefix the key or secret with VITE_.
FORMSUBMIT_ENDPOINT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Server-only admin login. Generate both with `npm run admin:password` from the repo root.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Stores registration open/closed (MongoDB Atlas connection string). MONGODB_DB defaults to "adroit".
MONGODB_URI=
MONGODB_DB=

# Public cloud name for image URLs in the browser. This is not a secret.
VITE_CLOUDINARY_CLOUD_NAME=

