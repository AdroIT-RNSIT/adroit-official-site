VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never prefix the key or secret with VITE_.
FORMSUBMIT_ENDPOINT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Server-only admin login. Generate both with `npm run admin:password` from the repo root.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Admin dashboard data: registration open/closed, members, contact inbox. MONGODB_DB defaults to "adroit".
MONGODB_URI=
MONGODB_DB=

# Optional recruitment CAPTCHA (Cloudflare Turnstile). Set both to turn it on. Server-only: no VITE_ prefix.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional key for hashing IPs in recruitment rate limits. Falls back to ADMIN_SESSION_SECRET.
RECRUITMENT_RATE_SECRET=

# Public cloud name for image URLs in the browser. This is not a secret.
VITE_CLOUDINARY_CLOUD_NAME=

