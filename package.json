{
  "name": "adroit-official-site",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run start-frontend\" \"npm run start-backend\"",
    "start-frontend": "cd frontend && npm run dev -- --host 0.0.0.0",
    "start-backend": "cd ai-service && python -m uvicorn main:app --host 0.0.0.0 --port 5000",
    "build": "cd frontend && npm install && npm run build",
    "prod": "concurrently \"npm run serve-frontend\" \"npm run start-backend\"",
    "serve-frontend": "cd frontend && npm run preview -- --host 0.0.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0"
  }
}
